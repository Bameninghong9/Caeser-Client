{
  "name": "caeser-client",
  "version": "0.3.33",
  "description": "Caeser Client – Minecraft Java Launcher für Windows",
  "main": "src/main.cjs",
  "scripts": {
    "prestart": "node scripts/write-build-config.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "prebuild": "node scripts/write-build-config.cjs",
    "build": "electron-builder --win nsis portable --x64 --publish never",
    "prerelease": "node scripts/write-build-config.cjs",
    "release": "electron-builder --win nsis portable --x64 --publish always"
  },
  "keywords": [],
  "author": "Caeser Client",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "private": true,
  "build": {
    "appId": "de.caeser.client",
    "productName": "Caeser Client",
    "publish": [
      {
        "provider": "github",
        "owner": "Bameninghong9",
        "repo": "Caeser-Client-Releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "resources/icon.png",
      "LICENSE",
      "NOTICE.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/caeserclient-1.0.0.jar",
        "to": "caeserclient-1.0.0.jar"
      },
      {
        "from": "resources/caeser-clipboard.exe",
        "to": "caeser-clipboard.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Caeser Client"
    },
    "portable": {
      "artifactName": "Caeser-Client-Portable-${version}.exe"
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  }
}
